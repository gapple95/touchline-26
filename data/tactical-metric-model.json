      "note": "Observed tracking-data benchmark; context only, not a target score."
    },
    "fifaWorldCup2022WideAttack": {
      "averagePlayersInBoxAfterWideProgression": 3.3,
      "averageWidePenaltyAreaEntriesPer90": 26.5,
      "note": "Observed match benchmark; not directly estimated without ball-event data."
    }
  },
  "metricDefinitions": [
    { "id": "possessionControl", "labelKo": "점유 통제", "mode": "OBSERVED_ONLY", "reason": "연속 볼 소유 이벤트가 필요합니다." },
    { "id": "ballRecoveryTime", "labelKo": "볼 회수 시간", "mode": "OBSERVED_ONLY", "reason": "소유 상실·회복 시점 데이터가 필요합니다." },
    { "id": "lineBreaks", "labelKo": "라인 브레이크", "mode": "PLANNED_PROXY", "reason": "지정 패스의 전진 방향과 적극도로 잠재력을 추정합니다." },
    { "id": "defensiveLineHeight", "labelKo": "수비 라인 높이", "mode": "PLANNED_DIRECT", "reason": "보드상 가장 낮은 수비 유닛의 위치를 미터로 환산합니다." },
    { "id": "teamLength", "labelKo": "팀 길이", "mode": "PLANNED_DIRECT", "reason": "골키퍼와 최전방 한 명을 제외한 블록의 세로 길이를 계산합니다." },
    { "id": "finalThirdEntries", "labelKo": "파이널 서드 진입", "mode": "PLANNED_PROXY", "reason": "파이널 서드 점유 인원과 전진 패스 의도로 잠재력을 추정합니다." },
    { "id": "forcedTurnovers", "labelKo": "강제 턴오버", "mode": "OBSERVED_ONLY", "reason": "압박 직후 상대의 볼 상실 이벤트가 필요합니다." },
    { "id": "pressureOnBall", "labelKo": "볼 압박", "mode": "PLANNED_PROXY", "reason": "적극성·수비 가담·라인 높이로 압박 의도를 추정합니다." },
    { "id": "expectedGoals", "labelKo": "기대득점", "mode": "OBSERVED_ONLY", "reason": "슈팅 위치·신체 부위·직전 행동 등 슈팅 데이터가 필요합니다." },
    { "id": "teamShape", "labelKo": "팀 형태", "mode": "PLANNED_DIRECT", "reason": "선수 좌표로 폭·길이·중앙 밀도·라인 간격을 계산합니다." },
    { "id": "receptionsBehindLines", "labelKo": "라인 뒤 수신", "mode": "PLANNED_PROXY", "reason": "지정 패스의 도착 위치와 공격 가담으로 잠재력을 추정합니다." },
    { "id": "phasesOfPlay", "labelKo": "플레이 단계", "mode": "PLANNED_PROXY", "reason": "배치와 지침을 바탕으로 의도한 빌드업·전진·압박·블록 성향을 분류합니다." }
  ],
  "supplementaryMetrics": [
    { "id": "ppda", "labelKo": "PPDA", "mode": "OBSERVED_ONLY", "reason": "상대 패스 수와 특정 구역의 태클·인터셉션·도전·파울 이벤트가 필요합니다." },
    { "id": "actionValue", "labelKo": "행동 가치(VAEP/OBV 계열)", "mode": "OBSERVED_ONLY", "reason": "연속 경기 이벤트와 득점·실점 확률 모델이 필요합니다." },
    { "id": "expectedThreat", "labelKo": "기대 위협(xT/EPV 계열)", "mode": "OBSERVED_ONLY", "reason": "볼 이동 이벤트와 학습된 공간별 위협 확률이 필요합니다." },
    { "id": "pitchControl", "labelKo": "공간 지배·피치 컨트롤", "mode": "OBSERVED_ONLY", "reason": "양 팀 선수의 시계열 위치·속도와 도달 시간 모델이 필요합니다." },
    { "id": "fieldTilt", "labelKo": "필드 틸트", "mode": "OBSERVED_ONLY", "reason": "양 팀의 공격 지역 터치 또는 패스 이벤트가 필요합니다." }
